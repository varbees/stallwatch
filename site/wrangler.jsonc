{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "stallwatch",
  "compatibility_date": "2026-07-04",

  // Pure static assets — there is no Worker script. The page is one HTML file
  // with no build step, no framework and no external requests, which is the
  // same constraint the binary it describes is held to.
  "assets": {
    "directory": "./public"
  },

  // Served from antharmaya.com/tools/stallwatch so link authority pools into one
  // domain. Workers Assets maps a URL path straight onto a file path and has no
  // basePath option, so public/ is nested to match the route rather than the
  // route being bent to match the files.
  //
  // The old hostname must stay alive as a redirect: the published installer is
  // curl -fsSL https://stallwatch.antharmaya.com/install.sh | sh, and every
  // copy of that command already in the wild is unfixable. -fsSL includes -L,
  // so a 301 is followed; without -L this move would break every installer.
  "routes": [
    { "pattern": "antharmaya.com/tools/stallwatch*", "zone_name": "antharmaya.com" }
  ]
}
